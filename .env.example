HOST=127.0.0.1
PORT=3000
ADMIN_API_KEY=replace-with-a-long-random-secret
CLIENT_KEY_STORE_PATH=.data/client-keys.json
PROVIDER_CONFIG_PATH=.data/providers.json
PROVIDER_IDS=openai,groq
PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_OPENAI_API_KEY=replace-me
PROVIDER_OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_GROQ_API_KEY=replace-me
PROVIDER_GROQ_MODELS=llama-3.3-70b-versatile
# For Gemini, add gemini to PROVIDER_IDS and configure:
# PROVIDER_GEMINI_TYPE=gemini
# PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# PROVIDER_GEMINI_API_KEY=replace-me
# PROVIDER_GEMINI_MODELS=gemini-2.5-flash
